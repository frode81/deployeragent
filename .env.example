# Domene for bruker-apper (*.apps.example.com) og agent (agent.apps.example.com)
BASE_DOMAIN=apps.ditt-domene.no

# Let's Encrypt e-post
ACME_EMAIL=deg@ditt-domene.no

# Hemmelighet dashboard bruker mot agent (x-agent-token)
AGENT_SECRET=

# Postgres admin
PG_ADMIN_USER=postgres
PG_ADMIN_PASSWORD=
PG_MAX_CONNECTIONS=300

# Redis
REDIS_PASSWORD=

# Valgfritt
BACKUP_MAX_FILES_PER_APP=5
NIXPACKS_NODE_VERSION=
DEPLOY_MAX_CONCURRENT=2
DEPLOY_MAX_QUEUED=100
