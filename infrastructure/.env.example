# Domene som alle deployede apper bruker (f.eks. apps.minplattform.no)
BASE_DOMAIN=apps.webserverpanel.com

# E-post for Let's Encrypt TLS-sertifikater
ACME_EMAIL=admin@webserverpanel.com

# Hemmelig token — deployer-appen sender dette til agenten
AGENT_SECRET=bytt_til_sterk_tilfeldig_streng

# Postgres: maks samtidige tilkoblinger (alle apper deler én instans)
PG_MAX_CONNECTIONS=300

# Agent: maks lagrede DB-backuper per app (eldste slettes først, standard 5)
BACKUP_MAX_FILES_PER_APP=5

# Valgfritt: Nixpacks Node når package.json ikke sier noe (f.eks. 20). La stå tom for kode-standard 22.
# NIXPACKS_NODE_VERSION=

# ── Agent: deploy-kø, timeouts, disk/image-rydding ─────────────────
# Maks samtidige deploy (clone+bygg+start) per agent-vert
# DEPLOY_MAX_CONCURRENT=2
# Maks antall deploy som venter på slot (0 = ubegrenset, ikke anbefalt i prod)
# DEPLOY_MAX_QUEUED=100
# Maks ventetid på slot i ms (0 = ingen ekstra tidsgrense utover kølengde)
# DEPLOY_QUEUE_SLOT_WAIT_MS=0
# DEPLOY_CLONE_TIMEOUT_MS=600000
# DEPLOY_BUILD_TIMEOUT_MS=1800000
# Periodisk vedlikehold: foreldreløse byggmapper + dangling images (ms, 0 = av)
# DEPLOY_MAINTENANCE_INTERVAL_MS=1800000
# Slett foreldreløse mapper under WORK_DIR eldre enn dette (ms), f.eks. 48t
# DEPLOY_ORPHAN_WORK_DIR_MAX_AGE_MS=172800000
# Docker build cache prune minst hver N ms (0 = aldri)
# DEPLOY_BUILDER_PRUNE_INTERVAL_MS=86400000
# Kommaseparert liste med prefiks som tillates for app-katalog (IMAGE), f.eks. docker.io/baserow/,ghcr.io/minorg/
# DEPLOY_PREBUILT_IMAGE_ALLOWLIST=docker.io/baserow/,docker.io/library/

# Postgres admin-passord
PG_ADMIN_USER=postgres
PG_ADMIN_PASSWORD=bytt_til_sterk_passord


# Redis-passord
REDIS_PASSWORD=bytt_til_sterk_passord
