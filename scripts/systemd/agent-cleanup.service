[Unit]
Description=Agent Docker cleanup (smart threshold-based)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
User=deploy
WorkingDirectory=/home/deploy/skybygger
ExecStart=/bin/bash /home/deploy/skybygger/scripts/cleanup-agent-server-smart.sh --yes --threshold=80 --path=/
Nice=10

